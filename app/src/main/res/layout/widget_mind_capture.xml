<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_mind"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Left Spacious Search Area -->
    <LinearLayout
        android:id="@+id/widget_btn_search"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_widget_circle_btn">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="center"
                android:contentDescription="Search Mind"
                android:src="@drawable/ic_widget_search" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Search Mind..."
            android:textColor="#CCEEF2FF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Circular Glass Action 1: Voice -->
    <FrameLayout
        android:id="@+id/widget_btn_voice"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_widget_circle_btn">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="center"
            android:contentDescription="Voice memory"
            android:src="@drawable/ic_widget_voice" />
    </FrameLayout>

    <!-- Circular Glass Action 2: Quick Note -->
    <FrameLayout
        android:id="@+id/widget_btn_note"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_widget_circle_btn">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="Quick note"
            android:src="@drawable/ic_widget_note" />
    </FrameLayout>

    <!-- Circular Gradient Action 3: Quick Add (+) -->
    <FrameLayout
        android:id="@+id/widget_btn_anything"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_widget_accent_circle">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="Add memory"
            android:src="@drawable/ic_widget_plus" />
    </FrameLayout>

</LinearLayout>
